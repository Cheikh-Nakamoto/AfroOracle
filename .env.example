META_API_KEY=          # Meta AI models (Muse Spark, Voice Transcribe, SAM 3.1)
POLYGON_RPC=           # Polygon Amoy RPC URL
PRIVATE_KEY=           # deployer key (testnet only)
DATABASE_URL=          # PostgreSQL DSN for submissions/publications (unset = in-memory mock)
WHATSAPP_TOKEN=        # Meta WhatsApp Cloud API access token
WHATSAPP_VERIFY_TOKEN= # webhook verification token (unset = GET handshake refused)
WHATSAPP_APP_SECRET=   # Meta app secret: HMAC-SHA256 of raw body checked in X-Hub-Signature-256 (unset = every POST 401)
WHATSAPP_NODES=        # wa_id:nodeID,... maps WhatsApp senders to registered nodes (unknown senders get 403)
