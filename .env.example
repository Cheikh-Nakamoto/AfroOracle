META_API_KEY=          # Meta AI models (Muse Spark, Voice Transcribe, SAM 3.1)
POLYGON_RPC=           # Polygon Amoy RPC URL (must report chain ID 80002)
PRIVATE_KEY=           # publisher wallet key; Amoy test POL only, never commit
CONTRACT_ADDRESS=      # deployed AgriculturalData address on Polygon Amoy
ORACLE_ZONE=Kaolack    # zone stored by backend publications
ORACLE_PRODUIT=millet  # product stored by backend publications
INSURANCE_THRESHOLD_X100=20000 # insurance threshold in FCFA x100 (200 FCFA/kg)
INSURANCE_CONTRACT_ADDRESS= # deployed ParametricInsurance address (for read-only check CLI)
ORACLE_DATE=           # publication date YYYY-MM-DD (default: today UTC)
DATABASE_URL=          # PostgreSQL DSN for submissions/publications (unset = in-memory mock)
WHATSAPP_TOKEN=        # Meta WhatsApp Cloud API access token
WHATSAPP_PHONE_NUMBER_ID= # sender number id for replies (POST /{id}/messages); unset = replies fail and are reported as reply_error
WHATSAPP_API_BASE=     # Graph API root (default https://graph.facebook.com/v21.0)
WHATSAPP_MAX_MEDIA_BYTES= # cap on downloaded voice/photo size (default 8388608)
WHATSAPP_VERIFY_TOKEN= # webhook verification token (unset = GET handshake refused)
WHATSAPP_APP_SECRET=   # Meta app secret: HMAC-SHA256 of raw body checked in X-Hub-Signature-256 (unset = every POST 401)
WHATSAPP_NODES=        # wa_id:nodeID,... maps WhatsApp senders to registered nodes (unknown senders get 403)
